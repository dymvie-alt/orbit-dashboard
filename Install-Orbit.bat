@echo off
title Orbit Dashboard v2.2.0 - Installer

echo ==========================================================
echo    Orbit Dashboard v2.2.0 - Quick Installer and Launcher
echo ==========================================================
echo.

powershell -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; $TargetDir=Join-Path $env:USERPROFILE '.gemini\config\plugins\orbit-dashboard'; $BatchDir='%~dp0'.TrimEnd('\'); if (Test-Path (Join-Path $BatchDir 'scripts\orbit-scanner.mjs')) { Write-Host '[1/3] Installing from extracted folder...' -ForegroundColor Yellow; if ($BatchDir.ToLower() -ne $TargetDir.ToLower()) { if (!(Test-Path $TargetDir)) { New-Item -ItemType Directory -Force -Path $TargetDir | Out-Null }; Copy-Item -Path ($BatchDir + '\*') -Destination $TargetDir -Recurse -Force } } else { Write-Host '[1/3] Detected direct execution from inside ZIP archive...' -ForegroundColor Yellow; $ZipFound=$null; $SearchDirs=@($env:USERPROFILE+'\Downloads', 'C:\CLAUDE PROJECTS', $env:USERPROFILE+'\Desktop', $env:USERPROFILE+'\Documents\antigravity\peaceful-hawking'); foreach ($d in $SearchDirs) { if (Test-Path $d) { $z=Get-ChildItem -Path $d -Filter '*orbit-dashboard*installer*.zip' -ErrorAction SilentlyContinue | Sort-Object LastWriteTime -Descending | Select-Object -First 1; if ($z) { $ZipFound=$z.FullName; break } } }; if ($ZipFound) { Write-Host ('Found ZIP package: ' + $ZipFound) -ForegroundColor Cyan; if (!(Test-Path $TargetDir)) { New-Item -ItemType Directory -Force -Path $TargetDir | Out-Null }; Expand-Archive -Path $ZipFound -DestinationPath $TargetDir -Force } elseif (!(Test-Path (Join-Path $TargetDir 'scripts\orbit-scanner.mjs'))) { Write-Host 'Downloading latest package from GitHub...' -ForegroundColor Cyan; $TmpZip=Join-Path $env:TEMP 'orbit-gh.zip'; Invoke-WebRequest -Uri 'https://github.com/dymvie-alt/orbit-dashboard/archive/refs/heads/main.zip' -OutFile $TmpZip; $TmpExt=Join-Path $env:TEMP 'orbit-gh-ext'; if (Test-Path $TmpExt) { Remove-Item -Recurse -Force $TmpExt }; Expand-Archive -Path $TmpZip -DestinationPath $TmpExt -Force; if (!(Test-Path $TargetDir)) { New-Item -ItemType Directory -Force -Path $TargetDir | Out-Null }; Copy-Item -Path ($TmpExt + '\orbit-dashboard-main\*') -Destination $TargetDir -Recurse -Force } }; Write-Host ('[OK] Plugin installed at: ' + $TargetDir) -ForegroundColor Green; Write-Host '[2/3] Scanning projects and building Orbit Multi-Project Hub...' -ForegroundColor Yellow; $ProjPath=$TargetDir; if (Test-Path 'C:\CLAUDE PROJECTS') { $sub=Get-ChildItem -Path 'C:\CLAUDE PROJECTS' -Directory | Select-Object -First 1; if ($sub) { $ProjPath=$sub.FullName } }; $Scanner=Join-Path $TargetDir 'scripts\orbit-scanner.mjs'; node $Scanner --project $ProjPath | Out-Null; $HubHtml=Join-Path $env:USERPROFILE '.gemini\antigravity\orbit\index.html'; if (Test-Path $HubHtml) { Write-Host '[3/3] [OK] Installation complete! Launching Orbit Dashboard in browser...' -ForegroundColor Green; Start-Process $HubHtml }"

echo.
pause
